package chrome

import (
	"fmt"

	"github.com/pietjan/loom/avatar"
	"github.com/pietjan/loom/badge"
	"github.com/pietjan/loom/icon"
	"github.com/pietjan/loom/navlist"
)

// sidebar is the service switcher. Items carry their bridge message in
// data-msg for the glue script's delegated click handler; hrefs are inert.
// Collapsed, it renders an icons-only rail with badge bubbles overlaid.
templ sidebar(state State) {
	<div class="flex h-full flex-col justify-between">
		@navlist.New(navlist.Label("Services")) {
			for _, item := range state.Items {
				@navlist.Item("#", itemOptions(state, item)...) {
					<span class="relative shrink-0">
						if len(item.Icon) > 0 {
							<img src={ iconURI(item.Icon) } alt="" class="size-6 rounded"/>
						} else {
							@avatar.New(avatar.Initials(initials(item.Name)), avatar.Alt(item.Name), avatar.Small)
						}
						if state.Collapsed && !item.Badge.Zero() {
							@badge.New(badge.Rose, badge.Pill(), badge.Small, badge.Solid(), badge.Class("absolute -top-1 -right-1 z-10 h-4 min-w-4 justify-center px-1 py-0 text-[10px] leading-none")) {
								if item.Badge.Count > 0 {
									{ badgeCount(item.Badge.Count) }
								} else {
									{ "•" }
								}
							}
						}
					</span>
					if !state.Collapsed {
						<span class="truncate">{ item.Name }</span>
						if item.Badge.Count > 0 {
							@badge.New(badge.Rose, badge.Pill(), badge.Small, badge.Class("ml-auto")) {
								{ fmt.Sprint(item.Badge.Count) }
							}
						} else if item.Badge.Dot {
							@badge.New(badge.Rose, badge.Pill(), badge.Small, badge.Class("ml-auto")) {
								{ "•" }
							}
						}
					}
				}
			}
		}
		@navlist.New(navlist.Label("App")) {
			@navlist.Item("#", toggleOptions(state)...) {
				if state.Collapsed {
					@icon.New(icon.CaretRight, icon.Small)
				} else {
					@icon.New(icon.CaretLeft, icon.Small)
					<span>Collapse</span>
				}
			}
			@navlist.Item("#", settingsOptions(state)...) {
				@icon.New(icon.GearSix, icon.Small)
				if !state.Collapsed {
					<span>Settings</span>
				}
			}
		}
	</div>
}

// badgeCount keeps overlay bubbles narrow.
func badgeCount(n int) string {
	if n > 99 {
		return "99+"
	}
	return fmt.Sprint(n)
}

func itemOptions(state State, item Item) []navlist.Option {
	options := []navlist.Option{
		navlist.Attr("data-msg", msgAttr("activate", map[string]any{"serviceId": item.ID})),
		navlist.Attr("data-service-id", fmt.Sprint(item.ID)),
		navlist.Attr("title", item.Name),
	}
	if state.Collapsed {
		options = append(options, navlist.Class("justify-center"))
	}
	if item.Active {
		options = append(options, navlist.Current())
	}
	return options
}

func toggleOptions(state State) []navlist.Option {
	options := []navlist.Option{
		navlist.Attr("data-msg", msgAttr("toggle-sidebar", nil)),
	}
	if state.Collapsed {
		options = append(options, navlist.Class("justify-center"), navlist.Attr("title", "Expand"))
	} else {
		options = append(options, navlist.Attr("title", "Collapse"))
	}
	return options
}

func settingsOptions(state State) []navlist.Option {
	options := []navlist.Option{
		navlist.Attr("data-msg", msgAttr("open-settings", nil)),
		navlist.Attr("title", "Settings"),
	}
	if state.Collapsed {
		options = append(options, navlist.Class("justify-center"))
	}
	if state.SettingsOpen {
		options = append(options, navlist.Current())
	}
	return options
}
